{
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/tenders/:id",
      "destination": "/api/tender-record?id=:id"
    },
    {
      "source": "/api/tenders/:id/:rest",
      "destination": "/api/tender-record?id=:id&rest=:rest"
    },
    {
      "source": "/app",
      "destination": "/index.html"
    },
    {
      "source": "/app/:path*",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/[...path].js": {
      "maxDuration": 60
    },
    "api/tenders.js": {
      "maxDuration": 60
    },
    "api/auth/*.js": {
      "maxDuration": 60
    },
    "api/genlayer.js": {
      "maxDuration": 60,
      "includeFiles": "tests/genlayer_direct/contracts/**"
    },
    "api/tender-record.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
